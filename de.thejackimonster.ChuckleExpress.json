{
	"app-id": "de.thejackimonster.ChuckleExpress",
	"runtime": "org.freedesktop.Platform",
	"runtime-version": "26.08",
	"sdk": "org.freedesktop.Sdk",
	"command": "chuckle-express",
	"finish-args": [
		"--device=dri",
		"--socket=wayland",
        "--socket=fallback-x11",
		"--share=ipc",
		"--socket=pulseaudio"
	],
	"modules": [
		{
			"name": "chuckle-express",
			"buildsystem": "simple",
			"build-commands": [
				"git lfs pull",
				"mkdir -p $FLATPAK_DEST/bin",
				"cp bin/chuckle-express-demo.$FLATPAK_ARCH $FLATPAK_DEST/bin/chuckle-express",
				"mkdir -p $FLATPAK_DEST/share",
				"cp -r share $FLATPAK_DEST/"
			],
			"sources": [
				{
					"type": "git",
					"url": "https://github.com/TheJackiMonster/chuckle-express.git",
					"tag": "v1.0.1",
					"commit": "c2fce0c0094b0cb7922e02f9f92a5f4be86a1b7e"
				}
			]
		}
	]
}
