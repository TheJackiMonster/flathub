{
	"app-id": "de.thejackimonster.ChuckleExpress",
	"runtime": "org.freedesktop.Platform",
	"runtime-version": "26.08",
	"sdk": "org.freedesktop.Sdk",
	"command": "chuckle-express",
	"finish-args": [
		"--device=dri",
		"--socket=wayland",
        "--socket=fallback-x11",
		"--share=ipc",
		"--socket=pulseaudio"
	],
	"modules": [
		{
			"name": "chuckle-express",
			"buildsystem": "simple",
			"only-arches": [
				"x86_64",
				"aarch64"
			],
			"build-commands": [
				"git lfs pull",
				"mkdir -p $FLATPAK_DEST/usr/bin",
				"cp bin/chuckle-express-demo.$FLATPAK_ARCH $FLATPAK_DEST/usr/bin/chuckle-express",
				"ln -s usr/bin/ $FLATPAK_DEST/bin",
				"mkdir -p $FLATPAK_DEST/usr/share",
				"cp -r share $FLATPAK_DEST/usr/",
				"ln -s usr/share/ $FLATPAK_DEST/share"
			],
			"sources": [
				{
					"type": "git",
					"url": "https://github.com/TheJackiMonster/chuckle-express.git",
					"tag": "v1.0.0-fix-license",
					"commit": "304d0c9f6d659b075f4be06ffa0127d5976764c1"
				}
			]
		}
	]
}
